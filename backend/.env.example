# Copy this file to ".env" (in the backend/ folder) and fill in your values.
# The backend loads it automatically on startup.

# 1. Create a bot: open Telegram, message @BotFather, send /newbot, follow prompts.
#    BotFather gives you a token that looks like the one below.
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMeWithYourRealBotToken

# 2. Get your chat id: message your new bot once (say "hi"), then visit:
#    https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
#    Look for "chat":{"id": ... } — that number is your chat id.
TELEGRAM_CHAT_ID=123456789
